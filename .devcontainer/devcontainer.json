{
  "name": "project-template-devcontainer",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": "..",
    "target": "cpu-dev",
    "args": {
      "PROJECT_UID": "${localEnv:PROJECT_UID:1000}",
      "PROJECT_GID": "${localEnv:PROJECT_GID:1000}"
    }
  },
  "containerUser": "project",
  "remoteUser": "project",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/workspace/project",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/project,type=bind,consistency=cached",
  "containerEnv": {
    "PROJECT_TEMPLATE_IMAGE": "1"
  },
  "shutdownAction": "stopContainer",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "python.analysis.extraPaths": ["${workspaceFolder}/python"],
        "python.defaultInterpreterPath": "/opt/project-venv/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  }
}
