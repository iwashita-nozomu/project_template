# @dependency-start
# contract configuration
# responsibility Records the exact AgentCanon source identity and reviewed pin.
# upstream contract tools/check_runtime_independence.py validates the exact path, URL, branch, and sole gitlink.
# downstream behavior project-owned bootstrap and validation do not initialize or consume this checkout.
# @dependency-end
[submodule "vendor/agent-canon"]
	path = vendor/agent-canon
	url = https://github.com/iwashita-nozomu/agent-canon.git
	branch = main
